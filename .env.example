# AgentHive Environment Example
# Copy to .env for local development. Never commit real secrets.

PROJECT_NAME=AgentHive
APP_ENV=development
APP_DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
POSTGRES_DB=agenthive
POSTGRES_USER=agenthive
POSTGRES_PASSWORD=agenthive
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://agenthive:agenthive@postgres:5432/agenthive

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=agenthive
MINIO_SECRET_KEY=agenthive123
MINIO_BUCKET=agenthive-files
MINIO_SECURE=false

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama3.1

# LLM Providers - API Keys & Custom Endpoints
# Provide API keys for external LLM providers. Unused providers will be skipped in fallback racing.
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
HUGGINGFACE_API_KEY=your-huggingface-api-key-here
GROQ_API_KEY=your-groq-api-key-here
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Default LLM Router & Fallback Policy
# Fallback strategy routes requests sequentially across healthy providers if primary fails.
DEFAULT_PRIMARY_PROVIDER=gemini
DEFAULT_SECONDARY_PROVIDER=ollama
DEFAULT_FALLBACK_ORDER=gemini,ollama,huggingface,groq,openai
DEFAULT_MAX_INPUT_TOKENS=12000
DEFAULT_MAX_OUTPUT_TOKENS=2048
DEFAULT_LLM_TIMEOUT_SECONDS=60

# Multi-Agent Engine & Speculative Parallel LLM Racing
# Orchestration patterns: router (fast intent classification), supervisor (task decomposition), swarm (peer handoffs)
DEFAULT_ORCHESTRATION_PATTERN=router
PARALLEL_LLM_RACING_ENABLED=true
PARALLEL_LLM_TIMEOUT_SECONDS=30.0
PARALLEL_LLM_DEFAULT_PROVIDERS=gemini,groq,ollama

# Tool Execution & Sandbox Flags
# Controls execution bounds and safety for the 40 registered tools (Web, Document, Text, Utility, Developer)
ENABLE_TOOL_SANDBOX=true
TOOL_TIMEOUT_SECONDS=30
DISABLE_UNSAFE_TOOLS=false
MAX_TOOL_RESULT_LENGTH=15000

# Logging, OpenTelemetry & Loki Integration
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_OTEL=true
OTEL_SERVICE_NAME=agenthive-backend
LOKI_URL=http://loki:3100

# Security & Secrets
SECRET_KEY=change-this-in-production
ENCRYPTION_KEY=dGhpc2lzYTMyYnl0ZWJhc2U2NGtleWZvcmxvY2FsMTI=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth (Configured in Keycloak Backend)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_API_KEY=your-google-api-key

